{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jfrog.com/evidence/github-pull-request/v1",
  "title": "Github Pull Request Evidence",
  "description": "The unified github-pull-request predicate created by the jfrog/git-evidence action. Carries the merged pull request and the repository branch-protection settings under separate root keys.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "subject_type",
    "predicate_type",
    "pull_request_merge",
    "branch_protection"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "subject_type": {
      "const": "GithubPullRequest"
    },
    "predicate_type": {
      "const": "https://jfrog.com/evidence/github-pull-request/v1"
    },
    "pull_request_merge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "merge",
        "approvers",
        "commits_on_target_branch",
        "code_committers",
        "commit_signatures",
        "all_commits_verified",
        "collection"
      ],
      "properties": {
        "merge": { "$ref": "#/$defs/merge" },
        "approvers": {
          "type": "array",
          "items": { "$ref": "#/$defs/approver" }
        },
        "commits_on_target_branch": {
          "type": "array",
          "items": { "type": "string" }
        },
        "code_committers": {
          "type": "array",
          "items": { "$ref": "#/$defs/codeCommitter" }
        },
        "commit_signatures": {
          "type": "array",
          "items": { "$ref": "#/$defs/commitSignature" }
        },
        "all_commits_verified": {
          "type": "boolean",
          "description": "True when the PR has at least one commit and every commit's signature was verified by GitHub."
        },
        "collection": { "$ref": "#/$defs/prCollection" }
      }
    },
    "branch_protection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "collection",
        "summary",
        "branches",
        "rulesets",
        "raw_snapshot"
      ],
      "properties": {
        "repository": {
          "type": "object",
          "additionalProperties": false,
          "required": ["owner", "name", "full_name", "url"],
          "properties": {
            "owner": { "type": "string" },
            "name": { "type": "string" },
            "full_name": { "type": "string" },
            "url": { "type": "string" }
          }
        },
        "collection": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "collected_at",
            "collector_version",
            "github_api_host",
            "workflow_run_url",
            "token_scope_note"
          ],
          "properties": {
            "collected_at": { "type": "string" },
            "collector_version": { "type": "string" },
            "github_api_host": { "type": "string" },
            "workflow_run_url": { "type": "string" },
            "token_scope_note": { "type": "string" }
          }
        },
        "summary": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "protected_branch_count",
            "ruleset_count",
            "has_codeowners_file",
            "codeowners_rule_count",
            "codeowners_validation_errors_present"
          ],
          "properties": {
            "protected_branch_count": { "type": "integer" },
            "ruleset_count": { "type": "integer" },
            "has_codeowners_file": { "type": "boolean" },
            "codeowners_rule_count": { "type": "integer" },
            "codeowners_validation_errors_present": { "type": "boolean" }
          }
        },
        "branches": {
          "type": "array",
          "items": { "$ref": "#/$defs/branch" }
        },
        "rulesets": {
          "type": "array",
          "items": { "$ref": "#/$defs/ruleset" }
        },
        "raw_snapshot": {
          "type": "object",
          "description": "Full branch-protection collector snapshot, embedded in the predicate."
        }
      }
    }
  },
  "$defs": {
    "merge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "merge_commit_sha",
        "merged_at",
        "merged_by",
        "target_branch",
        "target_base_sha"
      ],
      "properties": {
        "merge_commit_sha": { "type": "string" },
        "merged_at": { "type": "string" },
        "merged_by": { "type": "string" },
        "target_branch": { "type": "string" },
        "target_base_sha": { "type": "string" }
      }
    },
    "approver": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "review_id",
        "login",
        "email",
        "body",
        "submitted_at",
        "approved_sha",
        "is_pr_head_approval"
      ],
      "properties": {
        "review_id": { "type": "integer" },
        "login": { "type": ["string", "null"] },
        "email": {
          "type": ["string", "null"],
          "description": "Best-effort approver email: the user's public GitHub profile email when they have published one, else null. GitHub's reviews API does not itself carry an email."
        },
        "body": { "type": "string" },
        "submitted_at": { "type": ["string", "null"] },
        "approved_sha": { "type": "string" },
        "is_pr_head_approval": { "type": "boolean" }
      }
    },
    "codeCommitter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["login", "email"],
      "properties": {
        "login": { "type": ["string", "null"] },
        "email": {
          "type": "string",
          "description": "Lowercase commit-author email, or an empty string when unavailable."
        }
      }
    },
    "commitSignature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sha", "verified", "reason", "signer_login"],
      "properties": {
        "sha": { "type": "string" },
        "verified": {
          "type": "boolean",
          "description": "GitHub's cryptographic-signature verification result for the commit."
        },
        "reason": {
          "type": "string",
          "description": "GitHub verification reason (e.g. valid, unsigned, unknown_key); \"unsigned\" when no verification object was present."
        },
        "signer_login": { "type": ["string", "null"] }
      }
    },
    "prCollection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["collected_at", "workflow_run_url"],
      "properties": {
        "collected_at": {
          "type": "string",
          "description": "UTC timestamp emitted by `date -u +%Y-%m-%dT%H:%M:%S.000Z`.",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.000Z$"
        },
        "workflow_run_url": { "type": "string" }
      }
    },
    "branch": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "protection_source",
        "required_pull_request_reviews",
        "required_status_checks",
        "enforce_admins",
        "allow_force_pushes",
        "allow_deletions",
        "required_linear_history",
        "required_signatures",
        "restrictions",
        "code_owner_review_required",
        "collection_status"
      ],
      "properties": {
        "name": { "type": "string" },
        "protection_source": {
          "type": "array",
          "items": { "enum": ["branch_protection", "ruleset"] }
        },
        "required_pull_request_reviews": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "required",
            "required_approving_review_count",
            "require_code_owner_reviews",
            "dismiss_stale_reviews",
            "require_last_push_approval"
          ],
          "properties": {
            "required": { "type": "boolean" },
            "required_approving_review_count": { "type": "integer" },
            "require_code_owner_reviews": { "type": "boolean" },
            "dismiss_stale_reviews": { "type": "boolean" },
            "require_last_push_approval": { "type": "boolean" }
          }
        },
        "required_status_checks": {
          "type": "object",
          "additionalProperties": false,
          "required": ["strict", "checks"],
          "properties": {
            "strict": { "type": "boolean" },
            "checks": { "type": "array", "items": { "type": "string" } }
          }
        },
        "enforce_admins": { "type": "boolean" },
        "allow_force_pushes": { "type": "boolean" },
        "allow_deletions": { "type": "boolean" },
        "required_linear_history": { "type": "boolean" },
        "required_signatures": { "type": "boolean" },
        "restrictions": {
          "type": "object",
          "additionalProperties": false,
          "required": ["users", "teams", "apps"],
          "properties": {
            "users": { "type": "array", "items": { "type": "string" } },
            "teams": { "type": "array", "items": { "type": "string" } },
            "apps": { "type": "array", "items": { "type": "string" } }
          }
        },
        "code_owner_review_required": {
          "type": "object",
          "additionalProperties": false,
          "required": ["via_branch_protection", "via_ruleset"],
          "properties": {
            "via_branch_protection": { "type": "boolean" },
            "via_ruleset": { "type": "boolean" }
          }
        },
        "collection_status": {
          "type": "object",
          "additionalProperties": false,
          "required": ["protection", "effective_rules"],
          "properties": {
            "protection": { "enum": ["collected", "unavailable", "error"] },
            "effective_rules": { "enum": ["collected", "unavailable", "error"] }
          }
        }
      }
    },
    "ruleset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "enforcement", "target", "conditions", "rules"],
      "properties": {
        "id": { "type": "integer" },
        "name": { "type": "string" },
        "enforcement": { "type": "string" },
        "target": { "type": "string" },
        "conditions": { "type": "object" },
        "rules": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
